# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_router

# --- LLM / Embeddings ---
# Required for real (non-test) embeddings and LLM classification.
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
CHROMA_PERSIST_DIR=chroma_db
RETRIEVAL_TOP_K=3

#Groq
GROQ_API_KEY=
LLM_MODEL_NAME=openai/gpt-oss-20b

# Confidence threshold: predictions at or above this route automatically;
# below this go to human review. NOT a calibrated probability — see
# README "Limitations" for why.
CONFIDENCE_THRESHOLD=0.80

# --- Email integration (IMAP retrieval / SMTP notification) ---
# Optional — only needed for real mailbox integration (Mode 3). The app
# runs fully without these via API mode (Mode 1) or sample data (Mode 2).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Attachments ---
MAX_ATTACHMENT_SIZE_MB=10

# --- Streamlit UI ---
# Only read by streamlit_app/app.py, not by the FastAPI app itself.
API_BASE_URL=http://localhost:8000
